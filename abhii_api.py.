import requests

API_URL = "https://httpbin.org/get"

def check_api():
    try:
        response = requests.get(API_URL, timeout=15)
        response.raise_for_status()
        print("ABHII API Connected!")
        print(response.json())
    except requests.RequestException as e:
        print("API Error:", e)

if __name__ == "__main__":
    check_api()
